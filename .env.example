# Local SQLite file (default). For production use a Turso/libSQL URL, e.g. libsql://obsa-reset-xyz.turso.io
DATABASE_URL=file:./data/obsa.db
# Only needed for remote libSQL/Turso. TURSO_DATABASE_URL / TURSO_AUTH_TOKEN (set by Vercel's Turso integration) also work.
DATABASE_AUTH_TOKEN=
# Shared secret for the reminders cron endpoint (/api/cron/reminders)
CRON_SECRET=change-me
